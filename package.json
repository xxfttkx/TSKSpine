{
  "name": "tsk-spine-viewer",
  "private": true,
  "version": "1.0.0",
  "description": "Local Spine skeleton viewer for Twinkle Star Knights dumped assets (.skel/.atlas/.png)",
  "scripts": {
    "build": "esbuild viewer.js --bundle --outfile=viewer.bundle.js --format=iife --target=es2020",
    "start": "node serve.mjs"
  },
  "dependencies": {
    "@esotericsoftware/spine-webgl": "~4.0.31"
  },
  "devDependencies": {
    "esbuild": "latest"
  }
}
